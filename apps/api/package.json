{
  "name": "@gatherly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "db:dev": "node scripts/dev-db.mjs",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start:worker": "node dist/worker.js",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@exortek/express-mongo-sanitize": "3.0.0",
    "@gatherly/types": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.4",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "razorpay": "2.9.8",
    "resend": "^6.26.0",
    "socket.io": "4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "4.8.3",
    "supertest": "^7.2.2",
    "tsx": "4.23.6",
    "vitest": "^4.1.10"
  }
}
